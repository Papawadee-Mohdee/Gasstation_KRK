-- รวมแยกแต่ละ fact ให้เป็น วัน-สถานี-สินค้า ก่อน JOIN ป้องกัน many-to-many
with sold as (
    select f.date_id,f.gas_station_id,f.product_id,sum(f.quantity_sold) as quantity_sold
    from selected_sales f join dim_products p using(product_id)
    where p.product_type in ('Gasoline','Diesel') group by 1,2,3
), tank_out as (
    select date_id,gas_station_id,product_id,sum(quantity_out) as quantity_out
    from selected_inventory group by 1,2,3
), compared as (
    select coalesce(s.date_id,t.date_id) as date_id,
        coalesce(s.gas_station_id,t.gas_station_id) as gas_station_id,
        coalesce(s.product_id,t.product_id) as product_id,
        coalesce(s.quantity_sold,0) as quantity_sold,coalesce(t.quantity_out,0) as quantity_out,
        case when s.date_id is null then 'inventory_only' when t.date_id is null then 'sales_only' else 'both' end as coverage
    from sold s full outer join tank_out t on s.date_id=t.date_id
        and s.gas_station_id=t.gas_station_id and s.product_id=t.product_id
)
select c.*,d.date_day,g.gas_station_name,p.product_name,
    quantity_out-quantity_sold as difference_liters,
    case when c.product_id is null then 'unmapped_tank'
        when coverage <> 'both' then 'missing_counterpart'
        when abs(quantity_out-quantity_sold)>(select quantity_tolerance from settings) then 'review_difference'
        else 'matched' end as reconciliation_status
from compared c left join dim_date d using(date_id)
left join selected_stations g using(gas_station_id)
left join dim_products p using(product_id)
