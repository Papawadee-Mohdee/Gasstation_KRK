-- เปรียบเทียบเชิงพรรณนา; ไม่ใช่ผลทดสอบนัยสำคัญทางสถิติ
with source as (
    select gas_station_id,gas_station_name,day_type,count(*) as calendar_days,
        sum(sales_amount) as total_sales,sum(invoice_count) as total_invoices,
        avg(sales_amount) as avg_daily_sales,avg(invoice_count) as avg_daily_invoices
    from (select s.gas_station_id,s.gas_station_name,s.street,d.date_id,d.date_day,
d.weekday_number,d.weekday_name,d.day_type,
coalesce(sum(f.total_amount),0) as sales_amount,count(f.invoice_id) as invoice_count
from selected_stations s cross join selected_dates d
left join selected_invoices f on s.gas_station_id=f.gas_station_id and d.date_id=f.date_id
group by 1,2,3,4,5,6,7,8) group by 1,2,3
)
select *,'descriptive_only_not_significance_test' as interpretation from source
