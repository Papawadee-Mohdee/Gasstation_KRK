with source as (
    select s.gas_station_id,s.gas_station_name,p.product_id,p.product_name,
        coalesce(sum(f.quantity_sold),0) as liters_sold,
        coalesce(sum(f.sales_amount),0) as sales_amount
    from selected_stations s cross join dim_products p
    left join selected_sales f on s.gas_station_id=f.gas_station_id and p.product_id=f.product_id
    where p.product_type in ('Gasoline','Diesel') group by 1,2,3,4
)
select *,dense_rank() over(partition by gas_station_id order by liters_sold desc) as volume_rank,
    dense_rank() over(partition by gas_station_id order by sales_amount desc) as revenue_rank
from source
